{
  "name": "prizgram-e2e-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:smoke": "node scripts/run-playwright.mjs tests/smoke",
    "test:critical": "node scripts/run-playwright.mjs tests/critical",
    "test:integration": "node scripts/run-playwright.mjs tests/integration",
    "test:mobile": "node scripts/run-playwright.mjs tests/mobile",
    "test:ui": "playwright test --ui",
    "test:headed": "node scripts/run-playwright.mjs --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.15.3",
    "dotenv": "16.6.1",
    "typescript": "5.8.3"
  }
}
