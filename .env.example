# Required. Prefer localhost, preview, or staging.
E2E_BASE_URL=http://localhost:3000

# Required only for tests that create/update data.
E2E_ALLOW_MUTATION=false

# Production mutation is blocked even when E2E_ALLOW_MUTATION=true.
# Set this only for an intentionally isolated production-like environment.
E2E_ALLOW_PRODUCTION=false

# Comma-separated hosts treated as production.
E2E_PRODUCTION_HOSTS=prizgram.kuraryu.jp

# Optional: enables S11 reminder generation without modifying Prizgram.
# Point at a local checkout of kuraryu405/Prizgram and the same disposable DB
# used by the E2E target. The test invokes apps/web/scripts/run-reminders.ts.
E2E_PRIZGRAM_REPO=/absolute/path/to/Prizgram
E2E_DATABASE_URL=
